# Copy this file to .env and fill in values from your Supabase project.
# Keep .env private; never commit it or expose the service-role key in frontend code.
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5500
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
